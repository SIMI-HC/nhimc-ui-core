        "responsive-breakpoints"
      ],
      "differsOnlyBy": [
        "direction",
        "slide transition axis",
        "navigation keys",
        "flow direction"
      ],
      "contentPolicy": "one message per slide; Hero, Flow, key points, comparison, summary; no Form, SearchFilter, Pagination; Content fits the Safe Area and is centred by the Frame"
    }
