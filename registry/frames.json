      "direction": {
        "nhimc-presentation": "horizontal",
        "nhimc-presentation-vertical": "vertical"
      },
      "sharedRuntime": "src/presentation/presentation-runtime.js",
      "safeAreaPatch": "scripts/frame_patches.py",
      "slideElement": "section.slide[data-screen-panel]",
      "aiWrites": [
        "main[data-nhimc-role=content]"
      ],
      "frameOwns": [
        "presentation-canvas",
        "branding",
        "presentation-header",
        "presentation-controller",
        "content-safe-area",
        "content-center",
        "slide-transition",
        "slide-navigation",
        "presentation-runtime",
        "content-boundary",
        "responsive-breakpoints"
      ],
      "differsOnlyBy": [
        "direction",
        "slide transition axis",
        "navigation keys",
        "flow direction"
      ],
      "contentPolicy": "one message per slide; Hero, Flow, key points, comparison, summary; no Form, SearchFilter, Pagination; Content fits the Safe Area and is centred by the Frame"
    }
